# =============================================================================
# AFLATHOON EXCHANGE - ENVIRONMENT
# =============================================================================

# --- Flask ---
FLASK_APP=app.py
FLASK_ENV=development
SECRET_KEY=change-me-to-random-64-hex-chars
APP_NAME=Aflathoon Exchange Platform
APP_VERSION=1.0.0

# --- Database ---
DATABASE_URL=sqlite:////home/aflathoon/aflathoon_exchange/data/exchange.db
# DATABASE_URL=postgresql://user:pass@localhost:5432/aflathoon

# --- Margin (6.5% spread) ---
PLATFORM_MARGIN_PCT=0.065
SHIPPING_MARGIN_PCT=0.065
INSURANCE_MARGIN_PCT=0.065

# --- War-Risk Dynamic Pricing (CRITICAL WARNING #3) ---
# Prevents losses when war-risk premiums spike
WAR_RISK_BASE_PCT=0.0025
WAR_RISK_MAX_PCT=0.05
WAR_RISK_AUTO_HEDGE=true
WAR_RISK_RECHECK_MINUTES=15

# --- Rate API ---
SIFTINGIO_API_KEY=
TICKERLAYER_API_KEY=
INTRATEC_API_KEY=

# --- Crypto Custody (CRITICAL WARNING #2) ---
# NEVER store private keys on this server.
# Use external HSM / Fireblocks / BitGo / multi-sig vault.
CRYPTO_CUSTODY_MODE=external_multisig
CRYPTO_CUSTODY_PROVIDER=none
CRYPTO_HOT_WALLET_MAX_USD=5000
CRYPTO_REQUIRE_MULTISIG=true

# --- Licensing (CRITICAL WARNING #1) ---
# Platform REFUSES to enable live trading until licenses registered
LICENSE_ENFORCEMENT=strict
LICENSE_JURISDICTION=UK
LICENSE_REQUIRED_TYPES=msb,money_transmitter,crypto_asset
LIVE_TRADING_ENABLED=false

# --- Compliance ---
KYC_PROVIDER=none
SANCTIONS_PROVIDER=none
PEP_PROVIDER=none
AML_THRESHOLD_USD=10000

# --- Cache / Rate limit ---
CACHE_TYPE=SimpleCache
CACHE_DEFAULT_TIMEOUT=300
RATELIMIT_DEFAULT=100/hour

# --- Admin ---
ADMIN_USERNAME=admin
ADMIN_EMAIL=admin@localhost
FLASK_PORT=9105

# Rate limiter storage - explicit memory backend silences the startup warning.
# For production, swap to redis://localhost:6379/0
RATELIMIT_STORAGE_URI=memory://
